  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Consulat général" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Délivrance d'un visa de séjour" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_1" name="Agent consulaire">
        <bpmn:flowNodeRef>depart1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin32</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Consul adjoint">
        <bpmn:flowNodeRef>tache19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin27</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Demande de visa déposée"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:userTask id="tache2" name="Numériser les pièces du dossier"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux4" sourceRef="depart1" targetRef="tache2"/>
      <bpmn:dataObjectReference id="donnee7" name="Passeport" dataObjectRef="donnee7_o"/>
      <bpmn:dataObject id="donnee7_o"/>
