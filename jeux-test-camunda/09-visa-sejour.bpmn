      <bpmn:dataObject id="donnee11_o"/>
      <bpmn:userTask id="tache5" name="Vérifier l'authenticité des documents"><bpmn:property id="prop6" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture8"><bpmn:sourceRef>donnee7</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataInputAssociation id="lecture10"><bpmn:sourceRef>donnee9</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataOutputAssociation id="ecriture12"><bpmn:targetRef>donnee11</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux13" sourceRef="tache2" targetRef="tache5"/>
      <bpmn:sendTask id="tache16" name="Convoquer le demandeur à l'entretien"></bpmn:sendTask>
      <bpmn:sequenceFlow id="flux18" sourceRef="tache5" targetRef="tache16"/>
      <bpmn:dataObjectReference id="donnee22" name="Compte rendu d'entretien" dataObjectRef="donnee22_o"/>
      <bpmn:dataObject id="donnee22_o"/>
      <bpmn:userTask id="tache19" name="Statuer sur la délivrance du visa"><bpmn:property id="prop20" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture21"><bpmn:sourceRef>donnee11</bpmn:sourceRef><bpmn:targetRef>prop20</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataInputAssociation id="lecture23"><bpmn:sourceRef>donnee22</bpmn:sourceRef><bpmn:targetRef>prop20</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux24" sourceRef="tache16" targetRef="tache19"/>
      <bpmn:exclusiveGateway id="passerelle25" name="Visa accordé ?"/>
      <bpmn:sequenceFlow id="flux26" sourceRef="tache19" targetRef="passerelle25"/>
      <bpmn:endEvent id="fin27" name="Visa refusé"/>
      <bpmn:sequenceFlow id="flux28" sourceRef="passerelle25" targetRef="fin27" name="refusé"/>
      <bpmn:userTask id="tache29" name="Apposer la vignette au passeport"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux31" sourceRef="passerelle25" targetRef="tache29" name="accordé"/>
      <bpmn:endEvent id="fin32" name="Visa délivré"/>
      <bpmn:sequenceFlow id="flux33" sourceRef="tache29" targetRef="fin32"/>
      <bpmn:textAnnotation id="annot14"><bpmn:text>Convention consulaire et accords bilatéraux</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot15" sourceRef="annot14" targetRef="tache5"/>
  </bpmn:process>
