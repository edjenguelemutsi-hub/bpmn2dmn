  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Banque commerciale" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Instruction d'une demande de crédit" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_1" name="Chargé de clientèle">
        <bpmn:flowNodeRef>depart1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin39</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Comité de crédit">
        <bpmn:flowNodeRef>tache26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle32</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin34</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Demande de crédit reçue"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:userTask id="tache2" name="Saisir les informations du client"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux4" sourceRef="depart1" targetRef="tache2"/>
      <bpmn:dataObjectReference id="donnee7" name="Demande de crédit" dataObjectRef="donnee7_o"/>
      <bpmn:dataObject id="donnee7_o"/>
      <bpmn:dataObjectReference id="donnee9" name="Dossier constitué" dataObjectRef="donnee9_o"/>
      <bpmn:dataObject id="donnee9_o"/>
      <bpmn:userTask id="tache5" name="Vérifier la complétude du dossier"><bpmn:property id="prop6" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture8"><bpmn:sourceRef>donnee7</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataOutputAssociation id="ecriture10"><bpmn:targetRef>donnee9</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux11" sourceRef="tache2" targetRef="tache5"/>
      <bpmn:exclusiveGateway id="passerelle12" name="Dossier complet ?"/>
      <bpmn:sequenceFlow id="flux13" sourceRef="tache5" targetRef="passerelle12"/>
      <bpmn:endEvent id="fin14" name="Demande retournée"/>
      <bpmn:sequenceFlow id="flux15" sourceRef="passerelle12" targetRef="fin14" name="incomplet"/>
      <bpmn:dataStoreReference id="donnee19" name="Centrale des risques"/>
      <bpmn:dataObjectReference id="donnee21" name="Avis de solvabilité" dataObjectRef="donnee21_o"/>
      <bpmn:dataObject id="donnee21_o"/>
      <bpmn:userTask id="tache16" name="Évaluer la solvabilité du demandeur"><bpmn:property id="prop17" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture18"><bpmn:sourceRef>donnee9</bpmn:sourceRef><bpmn:targetRef>prop17</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataInputAssociation id="lecture20"><bpmn:sourceRef>donnee19</bpmn:sourceRef><bpmn:targetRef>prop17</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataOutputAssociation id="ecriture22"><bpmn:targetRef>donnee21</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux23" sourceRef="passerelle12" targetRef="tache16" name="complet"/>
      <bpmn:userTask id="tache26" name="Statuer sur l'octroi du crédit"><bpmn:property id="prop27" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture28"><bpmn:sourceRef>donnee21</bpmn:sourceRef><bpmn:targetRef>prop27</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux29" sourceRef="tache16" targetRef="tache26"/>
      <bpmn:exclusiveGateway id="passerelle32" name="Octroi accepté ?"/>
      <bpmn:sequenceFlow id="flux33" sourceRef="tache26" targetRef="passerelle32"/>
      <bpmn:endEvent id="fin34" name="Crédit non accordé"/>
      <bpmn:sequenceFlow id="flux35" sourceRef="passerelle32" targetRef="fin34" name="refus"/>
      <bpmn:sendTask id="tache36" name="Notifier la réponse au client"></bpmn:sendTask>
      <bpmn:sequenceFlow id="flux38" sourceRef="passerelle32" targetRef="tache36" name="accord"/>
      <bpmn:endEvent id="fin39" name="Crédit octroyé"/>
      <bpmn:sequenceFlow id="flux40" sourceRef="tache36" targetRef="fin39"/>
      <bpmn:textAnnotation id="annot24"><bpmn:text>Calcul du score interne selon la grille en vigueur</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot25" sourceRef="annot24" targetRef="tache16"/>
      <bpmn:textAnnotation id="annot30"><bpmn:text>Réglementation prudentielle COBAC applicable</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot31" sourceRef="annot30" targetRef="tache26"/>
  </bpmn:process>
