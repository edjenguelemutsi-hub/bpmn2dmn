        <bpmn:flowNodeRef>tache5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin12</bpmn:flowNodeRef>
      </bpmn:lane>
