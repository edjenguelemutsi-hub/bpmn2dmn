      <bpmn:sequenceFlow id="flux22" sourceRef="passerelle10" targetRef="tache14" name="complètes"/>
      <bpmn:userTask id="tache25" name="Statuer sur la délivrance du permis"><bpmn:property id="prop26" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture27"><bpmn:sourceRef>donnee20</bpmn:sourceRef><bpmn:targetRef>prop26</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux28" sourceRef="tache14" targetRef="tache25"/>
      <bpmn:exclusiveGateway id="passerelle29" name="Permis délivré ?"/>
      <bpmn:sequenceFlow id="flux30" sourceRef="tache25" targetRef="passerelle29"/>
      <bpmn:endEvent id="fin31" name="Permis refusé"/>
      <bpmn:sequenceFlow id="flux32" sourceRef="passerelle29" targetRef="fin31" name="refusé"/>
      <bpmn:userTask id="tache33" name="Établir l'arrêté municipal"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux35" sourceRef="passerelle29" targetRef="tache33" name="délivré"/>
