        <bpmn:flowNodeRef>tache33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin36</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Demande de permis déposée"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:userTask id="tache2" name="Enregistrer la demande"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux4" sourceRef="depart1" targetRef="tache2"/>
      <bpmn:dataObjectReference id="donnee7" name="Dossier de demande" dataObjectRef="donnee7_o"/>
      <bpmn:dataObject id="donnee7_o"/>
      <bpmn:userTask id="tache5" name="Vérifier la complétude des pièces"><bpmn:property id="prop6" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture8"><bpmn:sourceRef>donnee7</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux9" sourceRef="tache2" targetRef="tache5"/>
      <bpmn:exclusiveGateway id="passerelle10" name="Pièces complètes ?"/>
