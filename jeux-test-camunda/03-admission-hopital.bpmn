<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn2dmn/jeux" exporter="bpmn2dmn" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Centre hospitalier" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Admission d'un patient aux urgences" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_1" name="Infirmier d'accueil">
        <bpmn:flowNodeRef>depart1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Médecin urgentiste">
        <bpmn:flowNodeRef>tache14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bord24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin32</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Brancardier">
        <bpmn:flowNodeRef>tache25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin27</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Patient enregistré"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:userTask id="tache2" name="Mesurer les constantes vitales"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux4" sourceRef="depart1" targetRef="tache2"/>
      <bpmn:dataObjectReference id="donnee7" name="Fiche de constantes" dataObjectRef="donnee7_o"/>
      <bpmn:dataObject id="donnee7_o"/>
      <bpmn:dataObjectReference id="donnee9" name="Niveau de tri" dataObjectRef="donnee9_o"/>
      <bpmn:dataObject id="donnee9_o"/>
      <bpmn:userTask id="tache5" name="Coter la gravité du patient"><bpmn:property id="prop6" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture8"><bpmn:sourceRef>donnee7</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataOutputAssociation id="ecriture10"><bpmn:targetRef>donnee9</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux11" sourceRef="tache2" targetRef="tache5"/>
      <bpmn:dataObjectReference id="donnee17" name="Dossier médical" dataObjectRef="donnee17_o"/>
      <bpmn:dataObject id="donnee17_o"/>
      <bpmn:userTask id="tache14" name="Examiner le patient"><bpmn:property id="prop15" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture16"><bpmn:sourceRef>donnee9</bpmn:sourceRef><bpmn:targetRef>prop15</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataInputAssociation id="lecture18"><bpmn:sourceRef>donnee17</bpmn:sourceRef><bpmn:targetRef>prop15</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux19" sourceRef="tache5" targetRef="tache14"/>
      <bpmn:exclusiveGateway id="passerelle20" name="Hospitalisation requise ?"/>
      <bpmn:sequenceFlow id="flux21" sourceRef="tache14" targetRef="passerelle20"/>
      <bpmn:endEvent id="fin22" name="Patient orienté en consultation"/>
      <bpmn:sequenceFlow id="flux23" sourceRef="passerelle20" targetRef="fin22" name="soins ambulatoires"/>
      <bpmn:boundaryEvent id="bord24" name="Lit disponible" attachedToRef="tache14" cancelActivity="false"><bpmn:messageEventDefinition id="bord24_md"/></bpmn:boundaryEvent>
      <bpmn:userTask id="tache25" name="Installer le patient au lit"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux26" sourceRef="bord24" targetRef="tache25"/>
      <bpmn:endEvent id="fin27" name="Patient installé"/>
      <bpmn:sequenceFlow id="flux28" sourceRef="tache25" targetRef="fin27"/>
      <bpmn:userTask id="tache29" name="Rédiger le compte rendu d'admission"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux31" sourceRef="passerelle20" targetRef="tache29" name="hospitaliser"/>
      <bpmn:endEvent id="fin32" name="Patient hospitalisé"/>
      <bpmn:sequenceFlow id="flux33" sourceRef="tache29" targetRef="fin32"/>
      <bpmn:textAnnotation id="annot12"><bpmn:text>Score de gravité calculé selon l'échelle de tri</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot13" sourceRef="annot12" targetRef="tache5"/>
  </bpmn:process>
