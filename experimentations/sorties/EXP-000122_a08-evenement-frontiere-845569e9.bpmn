<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn2dmn/catalogue" exporter="bpmn2dmn" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Guichet unique du commerce extérieur" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Événement-frontière non interruptif" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_1" name="Chef de service">
        <bpmn:flowNodeRef>Depart_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tache_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bord_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passerelle_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Agent instructeur">
        <bpmn:flowNodeRef>Tache_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Depart_1" name="Demande déposée"></bpmn:startEvent>
      <bpmn:userTask id="Tache_2" name="Statuer sur la demande d'agrément"></bpmn:userTask>
      <bpmn:boundaryEvent id="Bord_4" name="Observation de l'opérateur" attachedToRef="Tache_2" cancelActivity="false"><bpmn:messageEventDefinition id="Bord_4_md"/></bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Passerelle_5" name="Agrément accordé ?"/>
      <bpmn:endEvent id="Fin_6" name="Agrément délivré"></bpmn:endEvent>
      <bpmn:endEvent id="Fin_7" name="Agrément refusé"></bpmn:endEvent>
      <bpmn:task id="Tache_8" name="Joindre l'observation au dossier"></bpmn:task>
      <bpmn:endEvent id="Fin_10" name="Observation classée"></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_11" sourceRef="Depart_1" targetRef="Tache_2"/>
      <bpmn:sequenceFlow id="Flux_12" sourceRef="Tache_2" targetRef="Passerelle_5"/>
      <bpmn:sequenceFlow id="Flux_13" sourceRef="Passerelle_5" targetRef="Fin_6" name="oui"/>
      <bpmn:sequenceFlow id="Flux_14" sourceRef="Passerelle_5" targetRef="Fin_7" name="non"/>
      <bpmn:sequenceFlow id="Flux_15" sourceRef="Bord_4" targetRef="Tache_8"/>
      <bpmn:sequenceFlow id="Flux_16" sourceRef="Tache_8" targetRef="Fin_10"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagramme_1">
    <bpmndi:BPMNPlane id="Plan_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="di_Pool_1" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="823" height="520"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Lane_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="190" y="80" width="793" height="260"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Lane_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="190" y="340" width="793" height="260"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Depart_1" bpmnElement="Depart_1"><dc:Bounds x="287" y="202" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Tache_2" bpmnElement="Tache_2"><dc:Bounds x="440" y="180" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Bord_4" bpmnElement="Bord_4"><dc:Bounds x="520" y="242" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="562" y="246" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Passerelle_5" bpmnElement="Passerelle_5"><dc:Bounds x="680" y="195" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="630" y="163" width="150" height="26"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Fin_6" bpmnElement="Fin_6"><dc:Bounds x="887" y="202" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Fin_7" bpmnElement="Fin_7"><dc:Bounds x="687" y="268" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Tache_8" bpmnElement="Tache_8"><dc:Bounds x="640" y="440" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Fin_10" bpmnElement="Fin_10"><dc:Bounds x="887" y="462" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_Flux_11" bpmnElement="Flux_11"><di:waypoint x="323" y="220"/><di:waypoint x="440" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_12" bpmnElement="Flux_12"><di:waypoint x="570" y="220"/><di:waypoint x="680" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_13" bpmnElement="Flux_13"><di:waypoint x="730" y="220"/><di:waypoint x="887" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_14" bpmnElement="Flux_14"><di:waypoint x="705" y="245"/><di:waypoint x="705" y="268"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_15" bpmnElement="Flux_15"><di:waypoint x="538" y="278"/><di:waypoint x="538" y="480"/><di:waypoint x="640" y="480"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_16" bpmnElement="Flux_16"><di:waypoint x="770" y="480"/><di:waypoint x="887" y="480"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
