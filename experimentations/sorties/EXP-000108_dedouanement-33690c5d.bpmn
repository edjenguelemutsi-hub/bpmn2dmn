<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
   Mainlevee d'une declaration en douane (dedouanement a l'import).
   Inspiration : procedure de dedouanement des administrations
   utilisant SYDONIA (CNUCED) et contexte du guichet unique du commerce
   exterieur (GUCE), voisin du cas d'etude FIMEX.
   3 decisions attendues (voir dedouanement.gold).
  =====================================================================
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Defs_douane" targetNamespace="http://bpmn2dmn/corpus/douane">
  <bpmn:process id="proc_douane" name="Mainlevée d'une déclaration en douane" isExecutable="false">

    <bpmn:laneSet id="ls1">
      <bpmn:lane id="l1" name="Inspecteur des douanes">
        <bpmn:flowNodeRef>debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l2" name="Chef de bureau">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l3" name="Système SYDONIA">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- donnees -->
    <bpmn:dataObjectReference id="do1" name="Déclaration en douane" dataObjectRef="do1_o"/>
    <bpmn:dataObject id="do1_o"/>
    <bpmn:dataObjectReference id="do2" name="Manifeste de cargaison" dataObjectRef="do2_o"/>
    <bpmn:dataObject id="do2_o"/>
    <bpmn:dataObjectReference id="do3" name="Avis de visite" dataObjectRef="do3_o"/>
    <bpmn:dataObject id="do3_o"/>
    <bpmn:dataStoreReference id="ds1" name="Fichier des importateurs"/>

    <!-- annotations -->
    <bpmn:textAnnotation id="an1"><bpmn:text>Réglementation douanière CEMAC : régimes et franchises applicables</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="an2"><bpmn:text>Grille de sélectivité des circuits (vert, jaune, rouge)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="an3"><bpmn:text>QR code du bon à enlever en pied de page</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as1" sourceRef="an1" targetRef="t6"/>
    <bpmn:association id="as2" sourceRef="an2" targetRef="t3"/>
    <bpmn:association id="as3" sourceRef="an3" targetRef="t5"/>

    <!-- chaine -->
    <bpmn:startEvent id="debut" name="Déclaration transmise">
      <bpmn:messageEventDefinition id="debut_med"/>
    </bpmn:startEvent>

    <bpmn:userTask id="t1" name="Enregistrer la déclaration au guichet"/>
    <bpmn:userTask id="t2" name="Saisir le manifeste de cargaison"/>

    <bpmn:userTask id="t3" name="Vérifier la déclaration en détail">
      <bpmn:dataInputAssociation id="dia1"><bpmn:sourceRef>do1</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="dia2"><bpmn:sourceRef>ds1</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Circuit de visite ?"/>

    <bpmn:userTask id="t4" name="Examiner les documents joints">
      <bpmn:dataInputAssociation id="dia3"><bpmn:sourceRef>do2</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="doa1"><bpmn:targetRef>do3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="t6" name="Statuer sur la mainlevée">
      <bpmn:dataInputAssociation id="dia4"><bpmn:sourceRef>do3</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Mainlevée accordée ?"/>
    <bpmn:endEvent id="fin1" name="Marchandises consignées"/>
    <bpmn:endEvent id="fin2" name="Contentieux ouvert"/>

    <bpmn:userTask id="t5" name="Imprimer le bon à enlever"/>
    <bpmn:serviceTask id="t7" name="Percevoir les droits et taxes"/>
    <bpmn:serviceTask id="t8" name="Enregistrer la mainlevée au manifeste"/>
    <bpmn:endEvent id="fin3" name="Marchandises enlevées"/>

    <bpmn:sequenceFlow id="f1" sourceRef="debut" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="f5" name="circuit rouge" sourceRef="g1" targetRef="t4"/>
    <bpmn:sequenceFlow id="f6" name="circuit vert" sourceRef="g1" targetRef="t7"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t6"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="g2"/>
    <bpmn:sequenceFlow id="f9" name="consignation" sourceRef="g2" targetRef="fin1"/>
    <bpmn:sequenceFlow id="f10" name="contentieux" sourceRef="g2" targetRef="fin2"/>
    <bpmn:sequenceFlow id="f11" name="mainlevée" sourceRef="g2" targetRef="t7"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t7" targetRef="t5"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t5" targetRef="t8"/>
    <bpmn:sequenceFlow id="f14" sourceRef="t8" targetRef="fin3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag_auto" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
    <bpmndi:BPMNPlane id="plane_auto" bpmnElement="proc_douane">
      <bpmndi:BPMNShape id="dis_debut" bpmnElement="debut"><dc:Bounds x="102" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t1" bpmnElement="t1"><dc:Bounds x="250" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t2" bpmnElement="t2"><dc:Bounds x="440" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t3" bpmnElement="t3"><dc:Bounds x="630" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_g1" bpmnElement="g1"><dc:Bounds x="855" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t4" bpmnElement="t4"><dc:Bounds x="1010" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t6" bpmnElement="t6"><dc:Bounds x="1200" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_g2" bpmnElement="g2"><dc:Bounds x="1425" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin1" bpmnElement="fin1"><dc:Bounds x="1622" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin2" bpmnElement="fin2"><dc:Bounds x="1622" y="352" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t5" bpmnElement="t5"><dc:Bounds x="1770" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t7" bpmnElement="t7"><dc:Bounds x="1580" y="460" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t8" bpmnElement="t8"><dc:Bounds x="1960" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin3" bpmnElement="fin3"><dc:Bounds x="2192" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do1" bpmnElement="do1"><dc:Bounds x="650" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do2" bpmnElement="do2"><dc:Bounds x="1090" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do3" bpmnElement="do3"><dc:Bounds x="1150" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_ds1" bpmnElement="ds1"><dc:Bounds x="650" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an1" bpmnElement="an1"><dc:Bounds x="1200" y="460" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an2" bpmnElement="an2"><dc:Bounds x="630" y="510" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an3" bpmnElement="an3"><dc:Bounds x="1770" y="560" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="die_f1" bpmnElement="f1"><di:waypoint x="120" y="240"/><di:waypoint x="310" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f2" bpmnElement="f2"><di:waypoint x="310" y="240"/><di:waypoint x="500" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f3" bpmnElement="f3"><di:waypoint x="500" y="240"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f4" bpmnElement="f4"><di:waypoint x="690" y="240"/><di:waypoint x="880" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f5" bpmnElement="f5"><di:waypoint x="880" y="240"/><di:waypoint x="1070" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f6" bpmnElement="f6"><di:waypoint x="880" y="240"/><di:waypoint x="1640" y="500"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f7" bpmnElement="f7"><di:waypoint x="1070" y="240"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f8" bpmnElement="f8"><di:waypoint x="1260" y="240"/><di:waypoint x="1450" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f9" bpmnElement="f9"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f10" bpmnElement="f10"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f11" bpmnElement="f11"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="500"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f12" bpmnElement="f12"><di:waypoint x="1640" y="500"/><di:waypoint x="1830" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f13" bpmnElement="f13"><di:waypoint x="1830" y="240"/><di:waypoint x="2020" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f14" bpmnElement="f14"><di:waypoint x="2020" y="240"/><di:waypoint x="2210" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as1" bpmnElement="as1"><di:waypoint x="1300" y="480"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as2" bpmnElement="as2"><di:waypoint x="730" y="530"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as3" bpmnElement="as3"><di:waypoint x="1870" y="580"/><di:waypoint x="1830" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia1" bpmnElement="dia1"><di:waypoint x="668" y="85"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia2" bpmnElement="dia2"><di:waypoint x="668" y="85"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia3" bpmnElement="dia3"><di:waypoint x="1108" y="85"/><di:waypoint x="1070" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_doa1" bpmnElement="doa1"><di:waypoint x="1070" y="240"/><di:waypoint x="1168" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia4" bpmnElement="dia4"><di:waypoint x="1168" y="85"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
