<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_Instruction_d_une_demande_FIMEX"
             name="Instruction d'une demande FIMEX"
             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.0">
  <decision id="D1" name="Affecter le dossier à un agent">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <decision id="D2" name="Vérifier la conformité documentaire">
    <informationRequirement id="ir3"><requiredInput href="#I3"/></informationRequirement>
    <informationRequirement id="ir4"><requiredInput href="#I4"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
    <decisionTable id="D2_table" hitPolicy="UNIQUE">
      <input id="D2_entree1" label="Dossier FIMEX"><inputExpression id="D2_entree1_expr" typeRef="string"><text>dossierFimex</text></inputExpression></input>
      <input id="D2_entree2" label="Observation de réexamen"><inputExpression id="D2_entree2_expr" typeRef="string"><text>observationDeReexamen</text></inputExpression></input>
      <output id="D2_sortie" label="Verdict : Vérifier la conformité documentaire" name="verifierLaConformiteDocumentaire" typeRef="string"><outputValues id="D2_sortie_valeurs"><text>"Incomplet","Non conforme","Conforme"</text></outputValues></output>
      <rule id="D2_regle1"><inputEntry id="D2_regle1_e1"><text>-</text></inputEntry><inputEntry id="D2_regle1_e2"><text>-</text></inputEntry><outputEntry id="D2_regle1_s"><text>"Incomplet"</text></outputEntry></rule>
      <rule id="D2_regle2"><inputEntry id="D2_regle2_e1"><text>-</text></inputEntry><inputEntry id="D2_regle2_e2"><text>-</text></inputEntry><outputEntry id="D2_regle2_s"><text>"Non conforme"</text></outputEntry></rule>
      <rule id="D2_regle3"><inputEntry id="D2_regle3_e1"><text>-</text></inputEntry><inputEntry id="D2_regle3_e2"><text>-</text></inputEntry><outputEntry id="D2_regle3_s"><text>"Conforme"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="D3" name="Consulter la demande et la décision">
    <informationRequirement id="ir5"><requiredDecision href="#D2"/></informationRequirement>
    <authorityRequirement id="ar2"><requiredAuthority href="#K2"/></authorityRequirement>
    <decisionTable id="D3_table" hitPolicy="UNIQUE">
      <input id="D3_entree1" label="Vérifier la conformité documentaire"><inputExpression id="D3_entree1_expr" typeRef="string"><text>verifierLaConformiteDocumentaire</text></inputExpression></input>
      <output id="D3_sortie" label="Verdict : Consulter la demande et la décision" name="consulterLaDemandeEtLaDecision" typeRef="string"><outputValues id="D3_sortie_valeurs"><text>"Signature accordée","Retour pour réexamen"</text></outputValues></output>
      <rule id="D3_regle1"><inputEntry id="D3_regle1_e1"><text>-</text></inputEntry><outputEntry id="D3_regle1_s"><text>"Signature accordée"</text></outputEntry></rule>
      <rule id="D3_regle2"><inputEntry id="D3_regle2_e1"><text>-</text></inputEntry><outputEntry id="D3_regle2_s"><text>"Retour pour réexamen"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Cotation automatique, aléatoire et équitable entre les agents actifs">
  </businessKnowledgeModel>
  <inputData id="I1" name="Agents actifs et leur charge"/>
  <inputData id="I2" name="Demande reçue"/>
  <inputData id="I3" name="Dossier FIMEX"/>
  <inputData id="I4" name="Observation de réexamen"/>
  <knowledgeSource id="K1" name="Réglementation FIMEX : pièces exigées, critères de recevabilité"/>
  <knowledgeSource id="K2" name="Agent signataire"/>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DRD_Instruction_d_une_demande_FIMEX">
      <dmndi:DMNShape id="s_D1" dmnElementRef="D1">
        <dc:Bounds x="86" y="230" width="194" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_D2" dmnElementRef="D2">
        <dc:Bounds x="366" y="230" width="206" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_D3" dmnElementRef="D3">
        <dc:Bounds x="366" y="40" width="206" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_B1" dmnElementRef="B1">
        <dc:Bounds x="-204" y="232" width="230" height="76"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_K2" dmnElementRef="K2">
        <dc:Bounds x="632" y="48" width="140" height="63"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I1" dmnElementRef="I1">
        <dc:Bounds x="110" y="430" width="145" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I2" dmnElementRef="I2">
        <dc:Bounds x="302" y="438" width="135" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I3" dmnElementRef="I3">
        <dc:Bounds x="482" y="438" width="135" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I4" dmnElementRef="I4">
        <dc:Bounds x="664" y="430" width="135" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_K1" dmnElementRef="K1">
        <dc:Bounds x="845" y="422" width="230" height="76"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="e_ir1" dmnElementRef="ir1">
        <di:waypoint x="183" y="430"/><di:waypoint x="180" y="310"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir2" dmnElementRef="ir2">
        <di:waypoint x="369" y="438"/><di:waypoint x="186" y="310"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_kr1" dmnElementRef="kr1">
        <di:waypoint x="26" y="270"/><di:waypoint x="86" y="270"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir3" dmnElementRef="ir3">
        <di:waypoint x="550" y="438"/><di:waypoint x="466" y="310"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir4" dmnElementRef="ir4">
        <di:waypoint x="731" y="430"/><di:waypoint x="472" y="310"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ar1" dmnElementRef="ar1">
        <di:waypoint x="960" y="422"/><di:waypoint x="572" y="270"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir5" dmnElementRef="ir5">
        <di:waypoint x="469" y="230"/><di:waypoint x="469" y="120"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ar2" dmnElementRef="ar2">
        <di:waypoint x="632" y="80"/><di:waypoint x="572" y="80"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
