      <dmndi:DMNEdge id="e_ir1" dmnElementRef="ir1">
        <di:waypoint x="189" y="430"/><di:waypoint x="183" y="310"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir2" dmnElementRef="ir2">
        <di:waypoint x="370" y="430"/><di:waypoint x="189" y="310"/>
