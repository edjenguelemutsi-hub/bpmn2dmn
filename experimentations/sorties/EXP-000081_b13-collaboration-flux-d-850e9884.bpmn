<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn2dmn/catalogue" exporter="bpmn2dmn" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Guichet unique du commerce extérieur" processRef="Process_1"/>
    <bpmn:participant id="Pool_2" name="Opérateur économique" processRef="Process_2"/>
    <bpmn:messageFlow id="Message_17" sourceRef="Tache_12" targetRef="Depart_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Collaboration et flux de message" isExecutable="false">
      <bpmn:startEvent id="Depart_1" name="Demande de l'opérateur"></bpmn:startEvent>
      <bpmn:userTask id="Tache_2" name="Vérifier la recevabilité de la demande"></bpmn:userTask>
      <bpmn:exclusiveGateway id="Passerelle_4" name="Demande recevable ?"/>
      <bpmn:endEvent id="Fin_5" name="Demande acceptée"></bpmn:endEvent>
      <bpmn:endEvent id="Fin_6" name="Demande rejetée"></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_7" sourceRef="Depart_1" targetRef="Tache_2"/>
      <bpmn:sequenceFlow id="Flux_8" sourceRef="Tache_2" targetRef="Passerelle_4"/>
      <bpmn:sequenceFlow id="Flux_9" sourceRef="Passerelle_4" targetRef="Fin_5" name="oui"/>
      <bpmn:sequenceFlow id="Flux_10" sourceRef="Passerelle_4" targetRef="Fin_6" name="non"/>
  </bpmn:process>
  <bpmn:process id="Process_2" name="Dépôt d'une demande" isExecutable="false">
      <bpmn:startEvent id="Depart_11" name="Besoin d'agrément"></bpmn:startEvent>
      <bpmn:sendTask id="Tache_12" name="Déposer la demande"></bpmn:sendTask>
      <bpmn:endEvent id="Fin_14" name="Demande transmise"></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_15" sourceRef="Depart_11" targetRef="Tache_12"/>
      <bpmn:sequenceFlow id="Flux_16" sourceRef="Tache_12" targetRef="Fin_14"/>
  </bpmn:process>
