      <bpmndi:BPMNEdge id="di_Flux_8" bpmnElement="Flux_8"><di:waypoint x="770" y="220"/><di:waypoint x="880" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_9" bpmnElement="Flux_9"><di:waypoint x="930" y="220"/><di:waypoint x="1087" y="220"/></bpmndi:BPMNEdge>
