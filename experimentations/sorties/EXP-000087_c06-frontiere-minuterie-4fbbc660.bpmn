<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn2dmn/catalogue" exporter="bpmn2dmn" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Guichet unique du commerce extérieur" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Frontière de minuterie" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_1" name="Chef de service">
        <bpmn:flowNodeRef>Depart_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tache_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bord_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passerelle_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Secrétariat">
        <bpmn:flowNodeRef>Tache_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Depart_1" name="Demande déposée"></bpmn:startEvent>
      <bpmn:dataObjectReference id="Donnee_4" name="Demande d'agrément" dataObjectRef="Donnee_4_o"/>
      <bpmn:dataObject id="Donnee_4_o"/>
      <bpmn:userTask id="Tache_2" name="Vérifier la recevabilité de la demande"><bpmn:property id="Prop_3" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="Lecture_5"><bpmn:sourceRef>Donnee_4</bpmn:sourceRef><bpmn:targetRef>Prop_3</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:boundaryEvent id="Bord_6" name="Délai de 15 jours" attachedToRef="Tache_2" cancelActivity="true"><bpmn:timerEventDefinition id="Bord_6_td"/></bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Passerelle_7" name="Demande recevable ?"/>
      <bpmn:endEvent id="Fin_8" name="Demande acceptée"></bpmn:endEvent>
      <bpmn:endEvent id="Fin_9" name="Demande rejetée"></bpmn:endEvent>
      <bpmn:task id="Tache_10" name="Relancer le demandeur"></bpmn:task>
      <bpmn:endEvent id="Fin_12" name="Demande relancée"></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_13" sourceRef="Depart_1" targetRef="Tache_2"/>
      <bpmn:sequenceFlow id="Flux_14" sourceRef="Tache_2" targetRef="Passerelle_7"/>
      <bpmn:sequenceFlow id="Flux_15" sourceRef="Passerelle_7" targetRef="Fin_8" name="oui"/>
      <bpmn:sequenceFlow id="Flux_16" sourceRef="Passerelle_7" targetRef="Fin_9" name="non"/>
      <bpmn:sequenceFlow id="Flux_17" sourceRef="Bord_6" targetRef="Tache_10"/>
      <bpmn:sequenceFlow id="Flux_18" sourceRef="Tache_10" targetRef="Fin_12"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagramme_1">
    <bpmndi:BPMNPlane id="Plan_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="di_Pool_1" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="823" height="520"/></bpmndi:BPMNShape>
