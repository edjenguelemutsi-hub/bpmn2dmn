      <bpmndi:BPMNShape id="di_Bord_6" bpmnElement="Bord_6"><dc:Bounds x="520" y="242" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="562" y="246" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Passerelle_7" bpmnElement="Passerelle_7"><dc:Bounds x="680" y="195" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="630" y="163" width="150" height="26"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Fin_8" bpmnElement="Fin_8"><dc:Bounds x="887" y="202" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Fin_9" bpmnElement="Fin_9"><dc:Bounds x="687" y="268" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Tache_10" bpmnElement="Tache_10"><dc:Bounds x="640" y="440" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_Fin_12" bpmnElement="Fin_12"><dc:Bounds x="887" y="462" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_Lecture_5" bpmnElement="Lecture_5"><di:waypoint x="465" y="150"/><di:waypoint x="465" y="162"/><di:waypoint x="475" y="162"/><di:waypoint x="475" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_13" bpmnElement="Flux_13"><di:waypoint x="323" y="220"/><di:waypoint x="440" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_14" bpmnElement="Flux_14"><di:waypoint x="570" y="220"/><di:waypoint x="680" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_15" bpmnElement="Flux_15"><di:waypoint x="730" y="220"/><di:waypoint x="887" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_16" bpmnElement="Flux_16"><di:waypoint x="705" y="245"/><di:waypoint x="705" y="268"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_17" bpmnElement="Flux_17"><di:waypoint x="538" y="278"/><di:waypoint x="538" y="480"/><di:waypoint x="640" y="480"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_Flux_18" bpmnElement="Flux_18"><di:waypoint x="770" y="480"/><di:waypoint x="887" y="480"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
