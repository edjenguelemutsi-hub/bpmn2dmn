             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_Instruction_d_un_permis_de_construire"
             name="Instruction d'un permis de construire"
             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.0">
  <decision id="D1" name="Vérifier la complétude de la demande de permis">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
  </decision>
  <decision id="D2" name="Examiner la conformité au plan d'urbanisme">
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <informationRequirement id="ir3"><requiredInput href="#I3"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>
  <decision id="D3" name="Statuer sur la délivrance du permis">
    <informationRequirement id="ir4"><requiredDecision href="#D2"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Barème des redevances de délivrance du permis">
  </businessKnowledgeModel>
  <inputData id="I1" name="Demande de permis"/>
  <inputData id="I2" name="Plans architecturaux"/>
  <inputData id="I3" name="Plan d'urbanisme"/>
  <knowledgeSource id="K1" name="Réglementation d'urbanisme : servitudes et emprises applicables"/>
