             id="Definitions_Instruction_d_une_demande_FIMEX"
             name="Instruction d'une demande FIMEX"
             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.0">
  <decision id="D1" name="Affecter le dossier à un agent">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <decision id="D2" name="Statuer sur la conformité du dossier">
    <informationRequirement id="ir3"><requiredInput href="#I3"/></informationRequirement>
    <informationRequirement id="ir4"><requiredInput href="#I4"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>
  <decision id="D3" name="Statuer sur la signature">
    <informationRequirement id="ir5"><requiredDecision href="#D2"/></informationRequirement>
    <authorityRequirement id="ar2"><requiredAuthority href="#K2"/></authorityRequirement>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Cotation automatique, aléatoire et équitable entre les agents actifs">
  </businessKnowledgeModel>
  <inputData id="I1" name="Agents actifs et leur charge"/>
  <inputData id="I2" name="Demande reçue"/>
  <inputData id="I3" name="Dossier FIMEX"/>
  <inputData id="I4" name="Observation de réexamen"/>
  <knowledgeSource id="K1" name="Réglementation FIMEX : pièces exigées, critères de recevabilité"/>
  <knowledgeSource id="K2" name="Agent signataire"/>
