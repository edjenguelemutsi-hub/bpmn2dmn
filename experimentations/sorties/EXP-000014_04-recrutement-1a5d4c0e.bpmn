      <bpmn:dataObject id="donnee7_o"/>
      <bpmn:dataStoreReference id="donnee9" name="Référentiel des postes"/>
      <bpmn:userTask id="tache5" name="Vérifier l'éligibilité de la candidature"><bpmn:property id="prop6" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture8"><bpmn:sourceRef>donnee7</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataInputAssociation id="lecture10"><bpmn:sourceRef>donnee9</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux11" sourceRef="tache2" targetRef="tache5"/>
      <bpmn:exclusiveGateway id="passerelle12" name="Profil éligible ?"/>
      <bpmn:sequenceFlow id="flux13" sourceRef="tache5" targetRef="passerelle12"/>
      <bpmn:endEvent id="fin14" name="Candidature non retenue"/>
      <bpmn:sequenceFlow id="flux15" sourceRef="passerelle12" targetRef="fin14" name="hors profil"/>
      <bpmn:sendTask id="tache16" name="Convoquer le candidat"></bpmn:sendTask>
      <bpmn:sequenceFlow id="flux18" sourceRef="passerelle12" targetRef="tache16" name="éligible"/>
