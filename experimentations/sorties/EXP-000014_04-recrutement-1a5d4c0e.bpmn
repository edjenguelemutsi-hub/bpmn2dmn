      <bpmn:dataObject id="donnee21_o"/>
      <bpmn:dataObjectReference id="donnee23" name="Note d'entretien" dataObjectRef="donnee23_o"/>
      <bpmn:dataObject id="donnee23_o"/>
      <bpmn:userTask id="tache19" name="Apprécier l'entretien du candidat"><bpmn:property id="prop20" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture22"><bpmn:sourceRef>donnee21</bpmn:sourceRef><bpmn:targetRef>prop20</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataOutputAssociation id="ecriture24"><bpmn:targetRef>donnee23</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux25" sourceRef="tache16" targetRef="tache19"/>
      <bpmn:exclusiveGateway id="passerelle28" name="Candidat retenu ?"/>
      <bpmn:sequenceFlow id="flux29" sourceRef="tache19" targetRef="passerelle28"/>
      <bpmn:endEvent id="fin30" name="Candidat remercié"/>
      <bpmn:sequenceFlow id="flux31" sourceRef="passerelle28" targetRef="fin30" name="écarté"/>
      <bpmn:endEvent id="fin32" name="Candidat recruté"/>
      <bpmn:sequenceFlow id="flux33" sourceRef="passerelle28" targetRef="fin32" name="retenu"/>
      <bpmn:textAnnotation id="annot26"><bpmn:text>Grille de notation des entretiens en vigueur</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot27" sourceRef="annot26" targetRef="tache19"/>
