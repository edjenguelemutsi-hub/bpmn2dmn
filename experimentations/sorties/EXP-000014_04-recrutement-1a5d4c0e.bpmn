        <bpmn:flowNodeRef>fin14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Responsable du recrutement">
        <bpmn:flowNodeRef>tache19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin32</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Candidature reçue"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:userTask id="tache2" name="Enregistrer la candidature"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux4" sourceRef="depart1" targetRef="tache2"/>
