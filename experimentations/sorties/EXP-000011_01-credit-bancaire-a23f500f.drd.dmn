             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.0">
  <decision id="D1" name="Vérifier la complétude du dossier">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
  </decision>
  <decision id="D2" name="Évaluer la solvabilité du demandeur">
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <informationRequirement id="ir3"><requiredDecision href="#D1"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <decision id="D3" name="Statuer sur l'octroi du crédit">
    <informationRequirement id="ir4"><requiredDecision href="#D2"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Calcul du score interne selon la grille en vigueur">
  </businessKnowledgeModel>
  <inputData id="I1" name="Demande de crédit"/>
  <inputData id="I2" name="Centrale des risques"/>
  <knowledgeSource id="K1" name="Réglementation prudentielle COBAC applicable"/>
