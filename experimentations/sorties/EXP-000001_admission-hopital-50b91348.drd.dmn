             id="Definitions_Admission_d_un_patient_aux_urgences"
             name="Admission d'un patient aux urgences"
             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.0">
  <decision id="D1" name="Évaluer l'état du patient à l'arrivée">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <informationRequirement id="ir3"><requiredInput href="#I3"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <decision id="D2" name="Examiner les antécédents médicaux">
    <informationRequirement id="ir4"><requiredInput href="#I4"/></informationRequirement>
  </decision>
  <decision id="D3" name="Décider de l'orientation du patient">
    <informationRequirement id="ir5"><requiredDecision href="#D1"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Score de gravité : calcul selon les constantes relevées">
  </businessKnowledgeModel>
  <inputData id="I1" name="Fiche d'admission"/>
  <inputData id="I2" name="Constantes vitales"/>
  <inputData id="I3" name="Résultats du laboratoire (optionnel)"/>
  <inputData id="I4" name="Dossier médical partagé"/>
  <knowledgeSource id="K1" name="Protocole national de tri des urgences : niveaux de gravité"/>
