             id="Definitions_Sous-processus_d_pli_"
             name="Sous-processus déplié"
             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.0">
  <decision id="D1" name="Vérifier la conformité des pièces">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
  </decision>
  <inputData id="I1" name="Demande d'agrément"/>
  <inputData id="I2" name="Pièce complémentaire reçue (optionnel)"/>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DRD_Sous-processus_d_pli_">
      <dmndi:DMNShape id="s_D1" dmnElementRef="D1">
        <dc:Bounds x="80" y="40" width="202" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I1" dmnElementRef="I1">
        <dc:Bounds x="114" y="240" width="135" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I2" dmnElementRef="I2">
        <dc:Bounds x="294" y="240" width="169" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="e_ir1" dmnElementRef="ir1">
        <di:waypoint x="181" y="240"/><di:waypoint x="178" y="120"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir2" dmnElementRef="ir2">
        <di:waypoint x="379" y="240"/><di:waypoint x="184" y="120"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
