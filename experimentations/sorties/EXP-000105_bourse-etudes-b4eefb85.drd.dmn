  <decision id="D1" name="Vérifier les pièces du dossier de bourse">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>
  <decision id="D2" name="Évaluer le mérite académique du candidat">
    <informationRequirement id="ir3"><requiredInput href="#I3"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <decision id="D3" name="Décider de l'attribution de la bourse">
    <informationRequirement id="ir4"><requiredDecision href="#D2"/></informationRequirement>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Calcul de la moyenne pondérée des résultats académiques">
  </businessKnowledgeModel>
  <inputData id="I1" name="Dossier de bourse"/>
  <inputData id="I2" name="Base des étudiants"/>
  <inputData id="I3" name="Relevés de notes"/>
  <knowledgeSource id="K1" name="Arrêté ministériel fixant les conditions d'attribution des bourses"/>
