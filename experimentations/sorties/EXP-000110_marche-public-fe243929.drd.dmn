  <decision id="D1" name="Vérifier la conformité administrative des offres">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
  </decision>
  <decision id="D2" name="Coter les offres techniques">
    <informationRequirement id="ir3"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir4"><requiredInput href="#I3"/></informationRequirement>
    <knowledgeRequirement id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>
  <decision id="D3" name="Statuer sur l'attribution du marché">
    <informationRequirement id="ir5"><requiredInput href="#I4"/></informationRequirement>
    <informationRequirement id="ir6"><requiredDecision href="#D2"/></informationRequirement>
    <authorityRequirement id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>
  <decision id="D4" name="Apprécier la recevabilité des recours">
    <informationRequirement id="ir7"><requiredInput href="#I5"/></informationRequirement>
  </decision>
  <businessKnowledgeModel id="B1" name="Règle : Formule de pondération technique et financière des offres">
