<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
   Instruction d'une demande de credit bancaire.
   Inspiration : domaine bancaire de Bazhenova, Zerbato, Oliboni et
   Weske (Information Systems 83, 2019 - exemples "loan approval" de la
   litterature BPM/DMN) et pratique des etablissements de credit CEMAC.
   Redige pour la banque de tests du transformateur BPMN->DMN.
   3 decisions attendues (voir credit-bancaire.gold).
  =====================================================================
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Defs_credit" targetNamespace="http://bpmn2dmn/corpus/credit">
  <bpmn:process id="proc_credit" name="Instruction d'une demande de crédit" isExecutable="false">

    <bpmn:laneSet id="ls1">
      <bpmn:lane id="l1" name="Chargé de clientèle">
        <bpmn:flowNodeRef>debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l2" name="Comité de crédit">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l3" name="Système bancaire central">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- donnees -->
    <bpmn:dataObjectReference id="do1" name="Demande de crédit" dataObjectRef="do1_o"/>
    <bpmn:dataObject id="do1_o"/>
    <bpmn:dataObjectReference id="do2" name="Relevés de compte" dataObjectRef="do2_o"/>
    <bpmn:dataObject id="do2_o"/>
    <bpmn:dataObjectReference id="do3" name="Plan d'affaires" dataObjectRef="do3_o"/>
    <bpmn:dataObject id="do3_o"/>
    <bpmn:dataObjectReference id="do4" name="Avis de solvabilité" dataObjectRef="do4_o"/>
    <bpmn:dataObject id="do4_o"/>
    <bpmn:dataStoreReference id="ds1" name="Centrale des risques"/>

    <!-- annotations -->
    <bpmn:textAnnotation id="an1"><bpmn:text>Réglementation prudentielle COBAC : ratios d'endettement à respecter</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="an2"><bpmn:text>Calcul du score interne de solvabilité selon la grille en vigueur</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="an3"><bpmn:text>Apposer le logo et le cachet de l'agence sur la notification</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as1" sourceRef="an1" targetRef="t6"/>
    <bpmn:association id="as2" sourceRef="an2" targetRef="t5"/>
    <bpmn:association id="as3" sourceRef="an3" targetRef="t7"/>

    <!-- chaine -->
    <bpmn:startEvent id="debut" name="Demande de crédit reçue">
      <bpmn:messageEventDefinition id="debut_med"/>
    </bpmn:startEvent>

    <bpmn:userTask id="t1" name="Saisir les informations du client"/>
    <bpmn:userTask id="t2" name="Constituer le dossier de garanties"/>

    <bpmn:userTask id="t3" name="Vérifier la complétude du dossier de crédit">
      <bpmn:dataInputAssociation id="dia1"><bpmn:sourceRef>do1</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Dossier complet ?"/>
    <bpmn:endEvent id="fin1" name="Demande retournée au client"/>

    <bpmn:businessRuleTask id="t5" name="Évaluer la solvabilité du demandeur">
      <bpmn:dataInputAssociation id="dia2"><bpmn:sourceRef>do2</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="dia3"><bpmn:sourceRef>do3</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="dia4"><bpmn:sourceRef>ds1</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="doa1"><bpmn:targetRef>do4</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>

    <bpmn:userTask id="t6" name="Statuer sur l'octroi du crédit">
      <bpmn:dataInputAssociation id="dia5"><bpmn:sourceRef>do4</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Octroi accepté ?"/>
    <bpmn:endEvent id="fin2" name="Crédit non accordé"/>

    <bpmn:sendTask id="t4" name="Notifier la réponse au client"/>
    <bpmn:serviceTask id="t7" name="Mettre en place le crédit au compte"/>
    <bpmn:userTask id="t8" name="Archiver le dossier de crédit"/>
    <bpmn:endEvent id="fin3" name="Dossier clos"/>

    <bpmn:sequenceFlow id="f1" sourceRef="debut" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="f5" name="incomplet" sourceRef="g1" targetRef="fin1"/>
    <bpmn:sequenceFlow id="f6" name="complet" sourceRef="g1" targetRef="t5"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="g2"/>
    <bpmn:sequenceFlow id="f9" name="refus" sourceRef="g2" targetRef="fin2"/>
    <bpmn:sequenceFlow id="f10" name="accord" sourceRef="g2" targetRef="t4"/>
    <bpmn:sequenceFlow id="f11" sourceRef="t4" targetRef="t7"/>
    <bpmn:sequenceFlow id="f12" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="fin3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag_auto" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
    <bpmndi:BPMNPlane id="plane_auto" bpmnElement="proc_credit">
      <bpmndi:BPMNShape id="dis_debut" bpmnElement="debut"><dc:Bounds x="102" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t1" bpmnElement="t1"><dc:Bounds x="250" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t2" bpmnElement="t2"><dc:Bounds x="440" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t3" bpmnElement="t3"><dc:Bounds x="630" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_g1" bpmnElement="g1"><dc:Bounds x="855" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin1" bpmnElement="fin1"><dc:Bounds x="1052" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t5" bpmnElement="t5"><dc:Bounds x="1010" y="330" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t6" bpmnElement="t6"><dc:Bounds x="1200" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_g2" bpmnElement="g2"><dc:Bounds x="1425" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin2" bpmnElement="fin2"><dc:Bounds x="1622" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t4" bpmnElement="t4"><dc:Bounds x="1580" y="330" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t7" bpmnElement="t7"><dc:Bounds x="1770" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t8" bpmnElement="t8"><dc:Bounds x="1960" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin3" bpmnElement="fin3"><dc:Bounds x="2192" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do1" bpmnElement="do1"><dc:Bounds x="650" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do2" bpmnElement="do2"><dc:Bounds x="1090" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do3" bpmnElement="do3"><dc:Bounds x="1150" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do4" bpmnElement="do4"><dc:Bounds x="1030" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_ds1" bpmnElement="ds1"><dc:Bounds x="1090" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an1" bpmnElement="an1"><dc:Bounds x="1200" y="460" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an2" bpmnElement="an2"><dc:Bounds x="1010" y="510" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an3" bpmnElement="an3"><dc:Bounds x="1770" y="560" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="die_f1" bpmnElement="f1"><di:waypoint x="120" y="240"/><di:waypoint x="310" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f2" bpmnElement="f2"><di:waypoint x="310" y="240"/><di:waypoint x="500" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f3" bpmnElement="f3"><di:waypoint x="500" y="240"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f4" bpmnElement="f4"><di:waypoint x="690" y="240"/><di:waypoint x="880" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f5" bpmnElement="f5"><di:waypoint x="880" y="240"/><di:waypoint x="1070" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f6" bpmnElement="f6"><di:waypoint x="880" y="240"/><di:waypoint x="1070" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f7" bpmnElement="f7"><di:waypoint x="1070" y="370"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f8" bpmnElement="f8"><di:waypoint x="1260" y="240"/><di:waypoint x="1450" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f9" bpmnElement="f9"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f10" bpmnElement="f10"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f11" bpmnElement="f11"><di:waypoint x="1640" y="370"/><di:waypoint x="1830" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f12" bpmnElement="f12"><di:waypoint x="1830" y="240"/><di:waypoint x="2020" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f13" bpmnElement="f13"><di:waypoint x="2020" y="240"/><di:waypoint x="2210" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as1" bpmnElement="as1"><di:waypoint x="1300" y="480"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as2" bpmnElement="as2"><di:waypoint x="1110" y="530"/><di:waypoint x="1070" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as3" bpmnElement="as3"><di:waypoint x="1870" y="580"/><di:waypoint x="1830" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia1" bpmnElement="dia1"><di:waypoint x="668" y="85"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia2" bpmnElement="dia2"><di:waypoint x="1108" y="85"/><di:waypoint x="1070" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia3" bpmnElement="dia3"><di:waypoint x="1168" y="85"/><di:waypoint x="1070" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia4" bpmnElement="dia4"><di:waypoint x="1108" y="85"/><di:waypoint x="1070" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_doa1" bpmnElement="doa1"><di:waypoint x="1070" y="370"/><di:waypoint x="1048" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia5" bpmnElement="dia5"><di:waypoint x="1048" y="85"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
