    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Déclaration déposée"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:serviceTask id="tache2" name="Générer la liquidation automatique"></bpmn:serviceTask>
