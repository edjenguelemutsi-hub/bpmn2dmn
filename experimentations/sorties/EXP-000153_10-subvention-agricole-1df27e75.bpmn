<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn2dmn/jeux" exporter="bpmn2dmn" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Ministère de l'agriculture" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Attribution d'une subvention agricole" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_1" name="Délégation départementale">
        <bpmn:flowNodeRef>tache5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Comité technique">
        <bpmn:flowNodeRef>tache19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passerelle34</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin36</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Plateforme e-Subvention">
        <bpmn:flowNodeRef>depart1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tache38</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin41</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="depart1" name="Demande de subvention reçue"><bpmn:messageEventDefinition id="depart1_md"/></bpmn:startEvent>
      <bpmn:serviceTask id="tache2" name="Contrôle automatique du formulaire"></bpmn:serviceTask>
      <bpmn:sequenceFlow id="flux4" sourceRef="depart1" targetRef="tache2"/>
      <bpmn:dataObjectReference id="donnee7" name="Dossier d'exploitation" dataObjectRef="donnee7_o"/>
      <bpmn:dataObject id="donnee7_o"/>
      <bpmn:dataStoreReference id="donnee9" name="Registre des exploitants"/>
      <bpmn:userTask id="tache5" name="Vérifier l'éligibilité de l'exploitation"><bpmn:property id="prop6" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture8"><bpmn:sourceRef>donnee7</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataInputAssociation id="lecture10"><bpmn:sourceRef>donnee9</bpmn:sourceRef><bpmn:targetRef>prop6</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux11" sourceRef="tache2" targetRef="tache5"/>
      <bpmn:exclusiveGateway id="passerelle12" name="Exploitation éligible ?"/>
      <bpmn:sequenceFlow id="flux13" sourceRef="tache5" targetRef="passerelle12"/>
      <bpmn:endEvent id="fin14" name="Demande rejetée"/>
      <bpmn:sequenceFlow id="flux15" sourceRef="passerelle12" targetRef="fin14" name="inéligible"/>
      <bpmn:userTask id="tache16" name="Programmer la visite de terrain"></bpmn:userTask>
      <bpmn:sequenceFlow id="flux18" sourceRef="passerelle12" targetRef="tache16" name="éligible"/>
      <bpmn:dataObjectReference id="donnee21" name="Rapport de visite" dataObjectRef="donnee21_o"/>
      <bpmn:dataObject id="donnee21_o"/>
      <bpmn:dataObjectReference id="donnee23" name="Note du projet" dataObjectRef="donnee23_o"/>
      <bpmn:dataObject id="donnee23_o"/>
      <bpmn:userTask id="tache19" name="Apprécier le projet agricole"><bpmn:property id="prop20" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture22"><bpmn:sourceRef>donnee21</bpmn:sourceRef><bpmn:targetRef>prop20</bpmn:targetRef></bpmn:dataInputAssociation>        <bpmn:dataOutputAssociation id="ecriture24"><bpmn:targetRef>donnee23</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux25" sourceRef="tache16" targetRef="tache19"/>
      <bpmn:userTask id="tache28" name="Statuer sur le montant de la subvention"><bpmn:property id="prop29" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="lecture30"><bpmn:sourceRef>donnee23</bpmn:sourceRef><bpmn:targetRef>prop29</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:sequenceFlow id="flux31" sourceRef="tache19" targetRef="tache28"/>
      <bpmn:exclusiveGateway id="passerelle34" name="Subvention accordée ?"/>
      <bpmn:sequenceFlow id="flux35" sourceRef="tache28" targetRef="passerelle34"/>
      <bpmn:endEvent id="fin36" name="Demande ajournée"/>
      <bpmn:sequenceFlow id="flux37" sourceRef="passerelle34" targetRef="fin36" name="ajournée"/>
      <bpmn:serviceTask id="tache38" name="Mettre en paiement la subvention"></bpmn:serviceTask>
      <bpmn:sequenceFlow id="flux40" sourceRef="passerelle34" targetRef="tache38" name="accordée"/>
      <bpmn:endEvent id="fin41" name="Subvention versée"/>
      <bpmn:sequenceFlow id="flux42" sourceRef="tache38" targetRef="fin41"/>
      <bpmn:textAnnotation id="annot26"><bpmn:text>Grille de notation des projets agricoles</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot27" sourceRef="annot26" targetRef="tache19"/>
      <bpmn:textAnnotation id="annot32"><bpmn:text>Décret fixant les plafonds de subvention</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="assocannot33" sourceRef="annot32" targetRef="tache28"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagramme_1">
