  <bpmn:process id="Process_1" name="Passerelle d'événements après une tâche" isExecutable="false">
      <bpmn:startEvent id="Depart_1" name="Demande déposée"></bpmn:startEvent>
      <bpmn:dataObjectReference id="Donnee_4" name="Demande d'agrément" dataObjectRef="Donnee_4_o"/>
      <bpmn:dataObject id="Donnee_4_o"/>
      <bpmn:userTask id="Tache_2" name="Instruire la demande"><bpmn:property id="Prop_3" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="Lecture_5"><bpmn:sourceRef>Donnee_4</bpmn:sourceRef><bpmn:targetRef>Prop_3</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:eventBasedGateway id="Passerelle_6"/>
      <bpmn:intermediateCatchEvent id="Evt_7" name="Réponse de l'opérateur reçue"><bpmn:messageEventDefinition id="Evt_7_md"/></bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="Evt_8" name="Délai de 30 jours écoulé"><bpmn:timerEventDefinition id="Evt_8_td"/></bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="Fin_9" name="Demande complétée"></bpmn:endEvent>
      <bpmn:endEvent id="Fin_10" name="Demande classée"></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_11" sourceRef="Depart_1" targetRef="Tache_2"/>
      <bpmn:sequenceFlow id="Flux_12" sourceRef="Tache_2" targetRef="Passerelle_6"/>
      <bpmn:sequenceFlow id="Flux_13" sourceRef="Passerelle_6" targetRef="Evt_7"/>
      <bpmn:sequenceFlow id="Flux_14" sourceRef="Passerelle_6" targetRef="Evt_8"/>
      <bpmn:sequenceFlow id="Flux_15" sourceRef="Evt_7" targetRef="Fin_9"/>
      <bpmn:sequenceFlow id="Flux_16" sourceRef="Evt_8" targetRef="Fin_10"/>
  </bpmn:process>
