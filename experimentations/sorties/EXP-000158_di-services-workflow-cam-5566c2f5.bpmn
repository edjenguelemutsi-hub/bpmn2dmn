<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_DI_Services" targetNamespace="http://e-guce.cm/bpmn/di-services" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_DI_Services">
    <bpmn:participant id="Participant_DI" name="e-GUCE 3G – Procédure DI Services" processRef="Process_DI_Services" />
    <bpmn:participant id="Participant_Douane" name="Système de la Douane" />
    <bpmn:participant id="Participant_Domiciliation" name="Module Domiciliation e-GUCE 3G (existant)" />
    <bpmn:messageFlow id="M1" name="demande de domiciliation de services + DI validée" sourceRef="S5" targetRef="Participant_Domiciliation" />
    <bpmn:messageFlow id="M2" name="DI validée (service soumis au contrôle douanier)" sourceRef="S6" targetRef="Participant_Douane" />
    <bpmn:textAnnotation id="Note_Dom">
      <bpmn:text>Domiciliation automatique si la valeur FOB atteint 5 000 000 FCFA et qu'aucune domiciliation n'est ouverte pour la facture</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As1" sourceRef="Note_Dom" targetRef="G_Dom" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DI_Services" name="e-GUCE 3G – Procédure DI Services" isExecutable="false">
    <bpmn:laneSet id="Process_DI_Services_lanes">
      <bpmn:lane id="L_ANA" name="Banque – Analyste commerce extérieur (e-Business)">
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Système e-GUCE 3G">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Dom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Sous</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Dou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoDou</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OPE" name="Opérateur importateur / CDA (eFORCE)">
        <bpmn:flowNodeRef>Start_DI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_DI" name="Nouvelle DI de services">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Renseigner le formulaire et joindre les pièces">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Choisir la banque de traitement et soumettre">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T5" name="Répondre au complément d&#39;information">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S1" name="Contrôler la soumission, attribuer le numéro de DI">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S2" name="Coter la DI à un analyste de la banque choisie (le même après complément)">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S3" name="Générer la DI validée (PDF, cachet, code QR), ajouté au répertoire des DI de services">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="S4" name="Notifier l&#39;opérateur : DI validée disponible dans eFORCE">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="G_Par" name="Suites de la validation">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G_Dom" name="Domiciliation automatique ?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S5" name="Déclencher la domiciliation de services (DI validée jointe)">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Dom" name="Domiciliation déclenchée">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Sous" name="DI validée délivrée, sans déclenchement automatique">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Dou" name="Soumise au contrôle douanier ?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S6" name="Transmettre la DI validée au système de la Douane">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Dou" name="DI validée transmise à la Douane">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoDou" name="DI validée non transmise à la Douane">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A1" name="Traiter la DI (pièces, régularité de l&#39;opération)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Dec" name="Décision ?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejet" name="DI rejetée (motif notifié)">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A2" name="Valider et signer électroniquement la DI">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_DI" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="S1" />
    <bpmn:sequenceFlow id="F7" name="complément d&#39;information" sourceRef="G_Dec" targetRef="T5" />
    <bpmn:sequenceFlow id="F8" name="réponse de l&#39;opérateur" sourceRef="T5" targetRef="S1" />
    <bpmn:sequenceFlow id="F4" sourceRef="S1" targetRef="S2" />
    <bpmn:sequenceFlow id="F5" sourceRef="S2" targetRef="A1" />
    <bpmn:sequenceFlow id="F11" sourceRef="A2" targetRef="S3" />
    <bpmn:sequenceFlow id="F12" sourceRef="S3" targetRef="S4" />
    <bpmn:sequenceFlow id="F13" sourceRef="S4" targetRef="G_Par" />
    <bpmn:sequenceFlow id="F14" sourceRef="G_Par" targetRef="G_Dom" />
    <bpmn:sequenceFlow id="F18" sourceRef="G_Par" targetRef="G_Dou" />
    <bpmn:sequenceFlow id="F15" name="oui" sourceRef="G_Dom" targetRef="S5" />
    <bpmn:sequenceFlow id="F17" name="non" sourceRef="G_Dom" targetRef="End_Sous" />
    <bpmn:sequenceFlow id="F16" sourceRef="S5" targetRef="End_Dom" />
    <bpmn:sequenceFlow id="F19" name="oui" sourceRef="G_Dou" targetRef="S6" />
    <bpmn:sequenceFlow id="F21" name="non" sourceRef="G_Dou" targetRef="End_NoDou" />
    <bpmn:sequenceFlow id="F20" sourceRef="S6" targetRef="End_Dou" />
    <bpmn:sequenceFlow id="F6" sourceRef="A1" targetRef="G_Dec" />
    <bpmn:sequenceFlow id="F9" name="rejet motivé" sourceRef="G_Dec" targetRef="End_Rejet" />
    <bpmn:sequenceFlow id="F10" name="validation" sourceRef="G_Dec" targetRef="A2" />
  </bpmn:process>
