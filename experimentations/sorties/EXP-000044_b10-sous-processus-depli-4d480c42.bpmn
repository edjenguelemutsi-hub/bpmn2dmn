      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Secrétariat">
        <bpmn:flowNodeRef>Tache_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Depart_1" name="Demande déposée"></bpmn:startEvent>
