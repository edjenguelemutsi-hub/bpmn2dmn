      <bpmn:dataObject id="Donnee_6_o"/>
      <bpmn:subProcess id="SousProcessus_2" name="Instruction du dossier">
      <bpmn:startEvent id="Depart_3" name=""></bpmn:startEvent>
      <bpmn:userTask id="Tache_4" name="Vérifier la conformité des pièces"><bpmn:property id="Prop_5" name="__targetRef_placeholder"/>        <bpmn:dataInputAssociation id="Lecture_7"><bpmn:sourceRef>Donnee_6</bpmn:sourceRef><bpmn:targetRef>Prop_5</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
      <bpmn:endEvent id="Fin_8" name=""></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_9" sourceRef="Depart_3" targetRef="Tache_4"/>
      <bpmn:sequenceFlow id="Flux_10" sourceRef="Tache_4" targetRef="Fin_8"/>
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="Bord_11" name="Pièce complémentaire reçue" attachedToRef="SousProcessus_2" cancelActivity="false"><bpmn:messageEventDefinition id="Bord_11_md"/></bpmn:boundaryEvent>
      <bpmn:task id="Tache_12" name="Verser la pièce au dossier"></bpmn:task>
      <bpmn:endEvent id="Fin_14" name="Pièce versée"></bpmn:endEvent>
      <bpmn:exclusiveGateway id="Passerelle_15" name="Pièces conformes ?"/>
      <bpmn:endEvent id="Fin_16" name="Dossier instruit"></bpmn:endEvent>
      <bpmn:endEvent id="Fin_17" name="Dossier rejeté"></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flux_18" sourceRef="Depart_1" targetRef="SousProcessus_2"/>
      <bpmn:sequenceFlow id="Flux_19" sourceRef="SousProcessus_2" targetRef="Passerelle_15"/>
      <bpmn:sequenceFlow id="Flux_20" sourceRef="Passerelle_15" targetRef="Fin_16" name="oui"/>
      <bpmn:sequenceFlow id="Flux_21" sourceRef="Passerelle_15" targetRef="Fin_17" name="non"/>
      <bpmn:sequenceFlow id="Flux_22" sourceRef="Bord_11" targetRef="Tache_12"/>
      <bpmn:sequenceFlow id="Flux_23" sourceRef="Tache_12" targetRef="Fin_14"/>
