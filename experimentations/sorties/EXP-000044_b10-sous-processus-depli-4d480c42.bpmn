        <bpmn:flowNodeRef>Depart_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Depart_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tache_4</bpmn:flowNodeRef>
