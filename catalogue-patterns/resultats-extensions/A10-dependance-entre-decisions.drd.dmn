<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             xmlns:bpmn2dmn="https://github.com/edjenguelemutsi-hub/bpmn2dmn/trace"
             id="Definitions_D_pendance_entre_deux_d_cisions"
             name="Dépendance entre deux décisions"
             namespace="http://bpmn2dmn/genere"
             exporter="bpmn2dmn" exporterVersion="1.2.0">
  <decision id="Decision_Tache_2" name="Vérifier la complétude du dossier">
    <extensionElements><bpmn2dmn:trace source="Tache_2" pattern="P1" motif="précède une passerelle exclusive + verbe décisionnel dans le libellé ; indice sémantique : score 0.76 (seuil 0.50), proche de « Vérifier l'admissibilité du dossier » (décision, similarité 0.76)"/></extensionElements>
    <informationRequirement id="ir1"><extensionElements><bpmn2dmn:trace pattern="P2"/></extensionElements><requiredInput href="#InputData_Donnee_4"/></informationRequirement>
    <decisionTable id="Decision_Tache_2_table" hitPolicy="UNIQUE">
      <input id="Decision_Tache_2_entree1" label="Demande d'agrément"><inputExpression id="Decision_Tache_2_entree1_expr" typeRef="string"><text>demandeDAgrement</text></inputExpression></input>
      <input id="Decision_Tache_2_entree2" label="Dossier complet ?"><inputExpression id="Decision_Tache_2_entree2_expr" typeRef="boolean"><text>dossierComplet</text></inputExpression></input>
      <output id="Decision_Tache_2_sortie" label="Dossier complet ?" name="verifierLaCompletudeDuDossier" typeRef="string"><outputValues id="Decision_Tache_2_sortie_valeurs"><text>"oui","non"</text></outputValues></output>
      <rule id="Decision_Tache_2_regle1"><inputEntry id="Decision_Tache_2_regle1_e1"><text>-</text></inputEntry><inputEntry id="Decision_Tache_2_regle1_e2"><text>true</text></inputEntry><outputEntry id="Decision_Tache_2_regle1_s"><text>"oui"</text></outputEntry></rule>
      <rule id="Decision_Tache_2_regle2"><inputEntry id="Decision_Tache_2_regle2_e1"><text>-</text></inputEntry><inputEntry id="Decision_Tache_2_regle2_e2"><text>false</text></inputEntry><outputEntry id="Decision_Tache_2_regle2_s"><text>"non"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="Decision_Tache_10" name="Statuer sur l'agrément">
    <extensionElements><bpmn2dmn:trace source="Tache_10" pattern="P1" motif="précède une passerelle exclusive + verbe décisionnel dans le libellé ; mais indice sémantique : score 0.36 (seuil 0.50), proche de « Imprimer l'étiquette du colis » (non décision, similarité 0.48)"/></extensionElements>
    <informationRequirement id="ir2"><extensionElements><bpmn2dmn:trace pattern="P4"/></extensionElements><requiredDecision href="#Decision_Tache_2"/></informationRequirement>
    <decisionTable id="Decision_Tache_10_table" hitPolicy="UNIQUE">
      <input id="Decision_Tache_10_entree1" label="Vérifier la complétude du dossier"><inputExpression id="Decision_Tache_10_entree1_expr" typeRef="string"><text>verifierLaCompletudeDuDossier</text></inputExpression></input>
      <input id="Decision_Tache_10_entree2" label="Agrément accordé ?"><inputExpression id="Decision_Tache_10_entree2_expr" typeRef="boolean"><text>agrementAccorde</text></inputExpression></input>
      <output id="Decision_Tache_10_sortie" label="Agrément accordé ?" name="statuerSurLAgrement" typeRef="string"><outputValues id="Decision_Tache_10_sortie_valeurs"><text>"oui","non"</text></outputValues></output>
      <rule id="Decision_Tache_10_regle1"><inputEntry id="Decision_Tache_10_regle1_e1"><text>-</text></inputEntry><inputEntry id="Decision_Tache_10_regle1_e2"><text>true</text></inputEntry><outputEntry id="Decision_Tache_10_regle1_s"><text>"oui"</text></outputEntry></rule>
      <rule id="Decision_Tache_10_regle2"><inputEntry id="Decision_Tache_10_regle2_e1"><text>-</text></inputEntry><inputEntry id="Decision_Tache_10_regle2_e2"><text>false</text></inputEntry><outputEntry id="Decision_Tache_10_regle2_s"><text>"non"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_Donnee_4" name="Demande d'agrément">
    <extensionElements><bpmn2dmn:trace source="Donnee_4" pattern="P2"/></extensionElements>
  </inputData>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DRD_D_pendance_entre_deux_d_cisions">
      <dmndi:DMNShape id="s_Decision_Tache_2" dmnElementRef="Decision_Tache_2">
        <dc:Bounds x="80" y="230" width="202" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_Decision_Tache_10" dmnElementRef="Decision_Tache_10">
        <dc:Bounds x="91" y="40" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_InputData_Donnee_4" dmnElementRef="InputData_Donnee_4">
        <dc:Bounds x="114" y="430" width="135" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="e_ir1" dmnElementRef="ir1">
        <di:waypoint x="181" y="430"/><di:waypoint x="181" y="310"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir2" dmnElementRef="ir2">
        <di:waypoint x="181" y="230"/><di:waypoint x="181" y="120"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
