  <inputData id="I1" name="Dossier de l'opérateur"/>
  <inputData id="I2" name="Historique des contrôles"/>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DRD_Corroboration_par_le_lexique">
      <dmndi:DMNShape id="s_D1" dmnElementRef="D1">
        <dc:Bounds x="80" y="40" width="223" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I1" dmnElementRef="I1">
        <dc:Bounds x="124" y="240" width="135" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I2" dmnElementRef="I2">
        <dc:Bounds x="306" y="240" width="135" height="60"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="e_ir1" dmnElementRef="ir1">
        <di:waypoint x="192" y="240"/><di:waypoint x="188" y="120"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir2" dmnElementRef="ir2">
        <di:waypoint x="373" y="240"/><di:waypoint x="194" y="120"/>
