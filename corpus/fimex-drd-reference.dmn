<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
   FIMEX : diagramme d'exigences de decision (DRD) infere du processus
   BPMN « Instruction d'une demande FIMEX ».

   DMN 1.3 (OMG). Ouvrir avec CAMUNDA MODELER (onglet DRD) ou sur
   https://demo.bpmn.io/dmn. Rendu noir sur blanc, notation OMG :
     decision                     rectangle
     donnee d'entree              forme a extremites semi-circulaires
     source de connaissance       rectangle a bord inferieur ondule
     modele de connaissance metier  rectangle a deux coins coupes
     exigence d'information       trait plein, pointe pleine
     exigence d'autorite          trait tirete termine par un disque
     exigence de connaissance     trait tirete, pointe ouverte

   3 decisions, 4 donnees d'entree, 2 sources de connaissance,
   1 modele de connaissance metier ; 5 IR, 2 AR, 1 KR.
  =====================================================================
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_FIMEX_DRD"
             name="Modèle de décision FIMEX"
             namespace="http://guce.cm/fimex/dmn"
             exporter="Camunda Modeler" exporterVersion="5.x">

  <!-- ===================== DECISIONS ===================== -->
  <decision id="D1" name="Affecter le dossier à un agent">
    <informationRequirement id="ir1"><requiredInput href="#I1"/></informationRequirement>
    <informationRequirement id="ir2"><requiredInput href="#I2"/></informationRequirement>
    <knowledgeRequirement  id="kr1"><requiredKnowledge href="#B1"/></knowledgeRequirement>
  </decision>

  <decision id="D2" name="Statuer sur la conformité du dossier">
    <informationRequirement id="ir3"><requiredInput href="#I3"/></informationRequirement>
    <informationRequirement id="ir4"><requiredInput href="#I4"/></informationRequirement>
    <authorityRequirement   id="ar1"><requiredAuthority href="#K1"/></authorityRequirement>
  </decision>

  <decision id="D3" name="Statuer sur la signature">
    <informationRequirement id="ir5"><requiredDecision href="#D2"/></informationRequirement>
    <authorityRequirement   id="ar2"><requiredAuthority href="#K2"/></authorityRequirement>
  </decision>

  <!-- ===================== DONNEES D'ENTREE ===================== -->
  <inputData id="I1" name="Demande reçue"/>
  <inputData id="I2" name="Agents actifs et leur charge"/>
  <inputData id="I3" name="Dossier FIMEX"/>
  <inputData id="I4" name="Observation de réexamen"/>

  <!-- ================= SOURCES DE CONNAISSANCE ================== -->
  <knowledgeSource id="K1" name="Réglementation FIMEX"/>
  <knowledgeSource id="K2" name="Agent signataire"/>

  <!-- ============ MODELE DE CONNAISSANCE METIER (BKM) =========== -->
  <businessKnowledgeModel id="B1" name="Règle de cotation aléatoire équitable"/>

  <!-- ========================== MISE EN PAGE ==================== -->
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DRD_FIMEX">

      <!-- groupe de gauche : affectation -->
      <dmndi:DMNShape id="s_B1" dmnElementRef="B1">
        <dc:Bounds x="10"   y="259" width="240" height="62"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_D1" dmnElementRef="D1">
        <dc:Bounds x="300"  y="250" width="260" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I1" dmnElementRef="I1">
        <dc:Bounds x="210"  y="470" width="210" height="55"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I2" dmnElementRef="I2">
        <dc:Bounds x="450"  y="470" width="210" height="55"/>
      </dmndi:DMNShape>

      <!-- groupe de droite : conformite puis signature -->
      <dmndi:DMNShape id="s_D3" dmnElementRef="D3">
        <dc:Bounds x="800"  y="40"  width="260" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_K2" dmnElementRef="K2">
        <dc:Bounds x="1120" y="49"  width="200" height="62"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_D2" dmnElementRef="D2">
        <dc:Bounds x="800"  y="250" width="260" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I3" dmnElementRef="I3">
        <dc:Bounds x="720"  y="470" width="210" height="55"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_I4" dmnElementRef="I4">
        <dc:Bounds x="960"  y="470" width="210" height="55"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="s_K1" dmnElementRef="K1">
        <dc:Bounds x="1210" y="465" width="200" height="65"/>
      </dmndi:DMNShape>

      <dmndi:DMNEdge id="e_ir1" dmnElementRef="ir1">
        <di:waypoint x="315" y="470"/><di:waypoint x="380" y="330"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir2" dmnElementRef="ir2">
        <di:waypoint x="555" y="470"/><di:waypoint x="480" y="330"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_kr1" dmnElementRef="kr1">
        <di:waypoint x="250" y="290"/><di:waypoint x="300" y="290"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="e_ir3" dmnElementRef="ir3">
        <di:waypoint x="825" y="470"/><di:waypoint x="880" y="330"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir4" dmnElementRef="ir4">
        <di:waypoint x="1065" y="470"/><di:waypoint x="990" y="330"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ar1" dmnElementRef="ar1">
        <di:waypoint x="1230" y="465"/><di:waypoint x="1050" y="332"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ir5" dmnElementRef="ir5">
        <di:waypoint x="930" y="250"/><di:waypoint x="930" y="120"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="e_ar2" dmnElementRef="ar2">
        <di:waypoint x="1120" y="80"/><di:waypoint x="1060" y="80"/>
      </dmndi:DMNEdge>

    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
