<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
   Admission d'un patient aux urgences hospitalieres.
   Inspiration : parcours de soins urgents (triage infirmier, protocoles
   nationaux de tri), parallele au cas BPCO de Bazhenova et al. (2019)
   utilise dans mes travaux anterieurs (evenement-frontiere non
   interrupteur, donnees cliniques, protocole d'autorite).
   3 decisions attendues (voir admission-hopital.gold).
  =====================================================================
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Defs_admission" targetNamespace="http://bpmn2dmn/corpus/admission">
  <bpmn:process id="proc_admission" name="Admission d'un patient aux urgences" isExecutable="false">

    <bpmn:laneSet id="ls1">
      <bpmn:lane id="l1" name="Infirmière d'accueil">
        <bpmn:flowNodeRef>debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l2" name="Médecin urgentiste">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- donnees -->
    <bpmn:dataObjectReference id="do1" name="Fiche d'admission" dataObjectRef="do1_o"/>
    <bpmn:dataObject id="do1_o"/>
    <bpmn:dataObjectReference id="do2" name="Constantes vitales" dataObjectRef="do2_o"/>
    <bpmn:dataObject id="do2_o"/>
    <bpmn:dataObjectReference id="do3" name="Fiche de triage" dataObjectRef="do3_o"/>
    <bpmn:dataObject id="do3_o"/>
    <bpmn:dataStoreReference id="ds1" name="Dossier médical partagé"/>

    <!-- annotations -->
    <bpmn:textAnnotation id="an1"><bpmn:text>Protocole national de tri des urgences : niveaux de gravité</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="an2"><bpmn:text>Score de gravité : calcul selon les constantes relevées</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as1" sourceRef="an1" targetRef="t6"/>
    <bpmn:association id="as2" sourceRef="an2" targetRef="t5"/>

    <!-- chaine -->
    <bpmn:startEvent id="debut" name="Patient arrivé">
      <bpmn:messageEventDefinition id="debut_med"/>
    </bpmn:startEvent>

    <bpmn:userTask id="t1" name="Enregistrer le patient à l'accueil"/>
    <bpmn:userTask id="t2" name="Saisir les constantes vitales"/>
    <bpmn:userTask id="t3" name="Installer le patient en salle d'attente"/>

    <bpmn:userTask id="t5" name="Évaluer l'état du patient à l'arrivée">
      <bpmn:dataInputAssociation id="dia1"><bpmn:sourceRef>do1</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="dia2"><bpmn:sourceRef>do2</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="doa1"><bpmn:targetRef>do3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="be1" name="Résultats du laboratoire" attachedToRef="t5" cancelActivity="false">
      <bpmn:messageEventDefinition id="be1_med"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="fin3" name="Résultats joints au dossier"/>

    <bpmn:userTask id="t4" name="Examiner les antécédents médicaux">
      <bpmn:dataInputAssociation id="dia3"><bpmn:sourceRef>ds1</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="t6" name="Décider de l'orientation du patient">
      <bpmn:dataInputAssociation id="dia4"><bpmn:sourceRef>do3</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Orientation ?"/>
    <bpmn:endEvent id="fin1" name="Patient hospitalisé"/>
    <bpmn:endEvent id="fin2" name="Retour à domicile"/>

    <bpmn:sequenceFlow id="f1" sourceRef="debut" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t5"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t5" targetRef="t4"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="t6"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t6" targetRef="g1"/>
    <bpmn:sequenceFlow id="f8" name="hospitalisation" sourceRef="g1" targetRef="fin1"/>
    <bpmn:sequenceFlow id="f9" name="soins ambulatoires" sourceRef="g1" targetRef="fin2"/>
    <bpmn:sequenceFlow id="f10" sourceRef="be1" targetRef="fin3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag_auto" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
    <bpmndi:BPMNPlane id="plane_auto" bpmnElement="proc_admission">
      <bpmndi:BPMNShape id="dis_debut" bpmnElement="debut"><dc:Bounds x="102" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t1" bpmnElement="t1"><dc:Bounds x="250" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t2" bpmnElement="t2"><dc:Bounds x="440" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t3" bpmnElement="t3"><dc:Bounds x="630" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t5" bpmnElement="t5"><dc:Bounds x="820" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_be1" bpmnElement="be1"><dc:Bounds x="102" y="352" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin3" bpmnElement="fin3"><dc:Bounds x="292" y="352" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t4" bpmnElement="t4"><dc:Bounds x="1010" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_t6" bpmnElement="t6"><dc:Bounds x="1200" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_g1" bpmnElement="g1"><dc:Bounds x="1425" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin1" bpmnElement="fin1"><dc:Bounds x="1622" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_fin2" bpmnElement="fin2"><dc:Bounds x="1622" y="352" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do1" bpmnElement="do1"><dc:Bounds x="840" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do2" bpmnElement="do2"><dc:Bounds x="900" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_do3" bpmnElement="do3"><dc:Bounds x="960" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_ds1" bpmnElement="ds1"><dc:Bounds x="1030" y="60" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an1" bpmnElement="an1"><dc:Bounds x="1200" y="460" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dis_an2" bpmnElement="an2"><dc:Bounds x="820" y="510" width="200" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="die_f1" bpmnElement="f1"><di:waypoint x="120" y="240"/><di:waypoint x="310" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f2" bpmnElement="f2"><di:waypoint x="310" y="240"/><di:waypoint x="500" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f3" bpmnElement="f3"><di:waypoint x="500" y="240"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f4" bpmnElement="f4"><di:waypoint x="690" y="240"/><di:waypoint x="880" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f5" bpmnElement="f5"><di:waypoint x="880" y="240"/><di:waypoint x="1070" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f6" bpmnElement="f6"><di:waypoint x="1070" y="240"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f7" bpmnElement="f7"><di:waypoint x="1260" y="240"/><di:waypoint x="1450" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f8" bpmnElement="f8"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f9" bpmnElement="f9"><di:waypoint x="1450" y="240"/><di:waypoint x="1640" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_f10" bpmnElement="f10"><di:waypoint x="120" y="370"/><di:waypoint x="310" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as1" bpmnElement="as1"><di:waypoint x="1300" y="480"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_as2" bpmnElement="as2"><di:waypoint x="920" y="530"/><di:waypoint x="880" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia1" bpmnElement="dia1"><di:waypoint x="858" y="85"/><di:waypoint x="880" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia2" bpmnElement="dia2"><di:waypoint x="918" y="85"/><di:waypoint x="880" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_doa1" bpmnElement="doa1"><di:waypoint x="880" y="240"/><di:waypoint x="978" y="85"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia3" bpmnElement="dia3"><di:waypoint x="1048" y="85"/><di:waypoint x="1070" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="die_dia4" bpmnElement="dia4"><di:waypoint x="978" y="85"/><di:waypoint x="1260" y="240"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
